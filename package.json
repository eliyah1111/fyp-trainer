{
  "name": "fyp-trainer",
  "version": "0.1.0",
  "description": "Reusable AI agent skill for transparent, user-confirmed TikTok For You Page training sessions.",
  "private": true,
  "type": "module",
  "bin": {
    "fyp-trainer": "./src/cli.js"
  },
  "scripts": {
    "run": "node ./src/cli.js run",
    "profile": "node ./src/cli.js profile",
    "train": "node ./src/cli.js train",
    "diagnose": "node ./src/cli.js diagnose",
    "plan": "node ./src/cli.js plan",
    "browser": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-regular-browser.ps1 -Browser default",
    "browser:chrome": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-regular-browser.ps1 -Browser chrome",
    "browser:edge": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-regular-browser.ps1 -Browser msedge",
    "browser:brave": "powershell -ExecutionPolicy Bypass -File ./scripts/launch-regular-browser.ps1 -Browser brave",
    "run:cdp": "node ./src/cli.js run --cdp=http://127.0.0.1:9222",
    "diagnose:cdp": "node ./src/cli.js diagnose --cdp=http://127.0.0.1:9222",
    "bootstrap": "node ./scripts/bootstrap.js",
    "check": "node ./scripts/check-syntax.js",
    "test": "node --test ./test/memory-store.test.js ./test/profile-analyzer.test.js ./test/session-planner.test.js ./test/discovery-engine.test.js ./test/tiktok-actions.test.js",
    "validate": "npm run check && npm test",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
